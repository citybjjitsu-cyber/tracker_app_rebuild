# CKB Tracker Frontend Environment Variables

# Backend API URL (required for local development and used as the proxy target in production)
# Development: http://127.0.0.1:8000
# Production: https://ckb-tracker-api-dev.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Set true in Vercel after the same-origin rewrites are deployed.
# Local development should remain false/unset.
NEXT_PUBLIC_API_PROXY=false
